// Tribr - data model
// Hosted on Postgres (Neon/Supabase) - DATABASE_URL points at it both for
// local dev and the deployed backend, so there's one shared database rather
// than a separate local SQLite file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users & Profiles (Chapter 2) ----------

model User {
  id                String    @id @default(cuid())
  phone             String    @unique
  phoneVerifiedAt   DateTime?
  acceptedTermsAt   DateTime?

  firstName         String?
  age               Int?
  gender            String?
  locationLabel     String?
  locationLat       Float?
  locationLng       Float?
  // Exact home address (2.5). Never exposed publicly - only resolved into a
  // HOME-type task's revealed address after a work day is confirmed (5.6).
  homeAddress       String?
  bio               String?
  profilePhotoUrl   String?
  profileComplete   Boolean   @default(false)

  subscriptionTier  String    @default("FREE") // FREE | SUBSCRIBER
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED | PENDING_DELETION
  lookingForGroup   Boolean   @default(true)

  // Push notifications (8.x) - timezone is the IANA name (e.g.
  // "Europe/London") captured from the device, used to fire the daily
  // digest at midday in the user's own local time.
  expoPushToken     String?
  timezone          String?
  lastDigestSentAt  DateTime?

  // hidden reputation seed so new accounts aren't volatile (2.10, 6.11)
  workerSeedApplied Boolean   @default(true)
  hostSeedApplied   Boolean   @default(true)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  photos            UserPhoto[]
  dietary           UserDietary[]
  tasks             Task[]
  ledGroups         Group[]              @relation("GroupLeader")
  memberships       GroupMember[]
  applications      GroupApplication[]
  invitationsRecv   GroupInvitation[]    @relation("InvitedUser")
  ratingsGiven      RatingEvent[]        @relation("Rater")
  ratingsReceived   RatingEvent[]        @relation("Ratee")
  notifications     Notification[]
  chatMessages      GroupChatMessage[]
  chatReads         GroupChatRead[]
  blocksMade        Block[]              @relation("Blocker")
  blocksReceived    Block[]              @relation("Blocked")
  reportsMade       Report[]             @relation("Reporter")
  reportsReceived   Report[]             @relation("ReportedUser")
  favouritesMade    Favourite[]          @relation("FavouriteOwner")
  favouritedBy      Favourite[]          @relation("FavouriteTarget")
  subscription      Subscription?
  dissolutionBallots DissolutionBallot[]
  kickVotesReceived  KickVote[]           @relation("KickTarget")
  kickVotesStarted   KickVote[]           @relation("KickInitiator")
  kickBallots        KickBallot[]
  availabilityResponses AvailabilityResponse[]
  proposalSubmissions   ProposalSubmission[]
  socialProposalSubmissions   SocialProposalSubmission[]
  socialAvailabilityResponses SocialAvailabilityResponse[]
  socialAttendances           SocialAttendance[]
}

model UserPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model UserDietary {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String // Vegetarian | Vegan | Pescatarian | No Seafood | Lactose Intolerant | Kosher | Halal | Food Allergies
  detail String? // free-text detail, only used for "Food Allergies"

  @@index([userId])
}

model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
}

// ---------- Job Categories (3.3, admin-manageable) ----------

model JobCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  active    Boolean @default(true)
  // 11.x - distinguishes Work Tribe task categories (the original list)
  // from Social Tribe activity categories (Hangout, Food & Drink, etc.) -
  // same table, filtered by kind rather than a second category system.
  kind      String  @default("WORK") // WORK | SOCIAL
  tasks     Task[]
  allowedInGroups GroupAllowedCategory[]
  socialGroups    Group[] @relation("SocialCategory")
}

// ---------- Personal Task System (Chapter 3) ----------

model Task {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name               String
  categoryId         String
  category           JobCategory @relation(fields: [categoryId], references: [id])
  description        String
  estimatedManHours  Float    // unused going forward, kept in place; see jobLength
  jobLength          String?  // FEW_HOURS | HALF_DAY | FULL_DAY
  locationType       String   // HOME | CHOOSE
  locationLabel      String?
  locationLat        Float?
  locationLng        Float?
  exactAddress       String?  // never exposed publicly; revealed only after confirmed work day (3.5, 5.6)
  notes              String?

  status             String   @default("AVAILABLE") // DRAFT|AVAILABLE|SUBMITTED|APPROVED|ACTIVE|COMPLETED|ARCHIVED|FORGONE|USER_ARCHIVED
  // 4.9/5.x - when this task most recently became the ACTIVE task in its
  // queue; anchors the 2-week scheduling window instead of "now".
  activatedAt        DateTime?

  groupId            String?
  group              Group?   @relation(fields: [groupId], references: [id])
  cycleId            String?
  cycle              GroupCycle? @relation(fields: [cycleId], references: [id])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  photos             TaskPhoto[]
  applications       GroupApplication[]
  invitations        GroupInvitation[]
  availabilityProposals AvailabilityProposal[]
  workDay            WorkDay?
  ratingEvents       RatingEvent[]

  @@index([ownerId])
  @@index([status])
}

model TaskPhoto {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url    String
}

// ---------- Groups & Lifecycle (Chapter 4) ----------

model Group {
  id                String   @id @default(cuid())
  name              String
  description       String
  locationLabel     String?
  locationLat       Float?
  locationLng       Float?
  preferredAgeMin   Int?
  preferredAgeMax   Int?
  preferredGender   String?
  durationBand      String?
  sizeMin           Int
  sizeMax           Int

  // 10.x - leader-set eligibility gates for who may apply/be invited.
  verifiedOnly      Boolean  @default(false)
  minRating         Float?   // 0-5 in 0.5 increments; null = no minimum

  leaderId          String
  leader            User     @relation("GroupLeader", fields: [leaderId], references: [id])

  state             String   @default("RECRUITING")
  // RECRUITING | READY | WORKING | COMPLETED | DISSOLUTION | DISBANDED

  currentCycleNumber Int     @default(1)

  // ---------- Social Tribes (11.x) ----------
  // tribeType discriminates Work Tribes (the task-per-member system above,
  // unchanged) from Social Tribes (one shared activity for the whole group,
  // no per-member task). Every field below is null/default for Work Tribes.
  tribeType         String   @default("WORK") // WORK | SOCIAL
  socialCategoryId  String?
  socialCategory    JobCategory? @relation("SocialCategory", fields: [socialCategoryId], references: [id])
  dateType          String?  // FIXED | SCHEDULE_TOGETHER (Social only)
  fixedDate         DateTime?
  fixedAllDay       Boolean?
  fixedStartTime    String?
  fixedEndTime      String?
  // Anchors the 2-week "Schedule Together" proposal window - the same role
  // task.activatedAt plays for Work Tribe scheduling. Stamped when the
  // Tribe starts.
  socialScheduleWindowStart DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members           GroupMember[]
  applications      GroupApplication[]
  invitations       GroupInvitation[]
  tasks             Task[]
  cycles            GroupCycle[]
  chatMessages      GroupChatMessage[]
  chatReads         GroupChatRead[]
  dissolutionVotes  DissolutionVote[]
  kickVotes         KickVote[]
  allowedCategories GroupAllowedCategory[]
  socialEventProposal SocialEventProposal?
  socialEvent         SocialEvent?
  socialAttendances   SocialAttendance[]

  @@index([state])
}

// Member removal once a group is WORKING - no leader shortcut at that point,
// it takes every other active member agreeing. Before WORKING, the leader
// can just remove someone directly (see groups.ts) so this only ever gets
// created for a group that's already underway.
model KickVote {
  id           String   @id @default(cuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User     @relation("KickTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  initiatorId  String
  initiator    User     @relation("KickInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  reason       String
  outcome      String?  // null while pending, then REMOVED | FAILED
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  ballots      KickBallot[]

  @@index([groupId])
}

model KickBallot {
  id        String   @id @default(cuid())
  voteId    String
  vote      KickVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voterId   String
  voter     User     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  choice    String   // YES | NO
  createdAt DateTime @default(now())

  @@unique([voteId, voterId])
}

model GroupAllowedCategory {
  id         String      @id @default(cuid())
  groupId    String
  group      Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  categoryId String
  category   JobCategory @relation(fields: [categoryId], references: [id])

  @@unique([groupId, categoryId])
  @@index([groupId])
}

model GroupCycle {
  id            String    @id @default(cuid())
  groupId       String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cycleNumber   Int
  startedAt     DateTime?
  completedAt   DateTime?
  taskOrder     String? // JSON array of taskIds, server-computed default order (4.9)

  tasks         Task[]

  @@index([groupId])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLeader  Boolean  @default(false)
  status    String   @default("ACTIVE") // ACTIVE | LEFT
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  // Optional goodbye message left when completing the wrap-up flow for a
  // finished Tribe - stored structurally (not just as chat text) so the
  // final farewell report can be compiled once everyone's left.
  farewellMessage String?

  @@unique([groupId, userId])
  @@index([groupId])
}

model GroupApplication {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  // Required for Work Tribe applications (every applicant brings a task);
  // null for Social Tribe applications, which just ask to join the shared
  // activity with no task involved (11.x).
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id])
  message     String?

  status      String   @default("PENDING")
  // PENDING | APPROVED | REJECTED | TASK_SUGGESTED | TASK_REQUESTED | WITHDRAWN
  rejectionReason String?
  suggestedTaskId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId])
  @@index([applicantId])
}

model GroupInvitation {
  id               String   @id @default(cuid())
  groupId          String
  group            Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUserId    String
  invitedUser      User     @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  suggestedTaskId  String?
  suggestedTask    Task?    @relation(fields: [suggestedTaskId], references: [id])

  status           String   @default("PENDING") // PENDING | ACCEPTED | DECLINED

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([groupId])
  @@index([invitedUserId])
}

// ---------- Scheduling (Chapter 5) ----------

model AvailabilityProposal {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  // 5.3 - the task owner gets exactly one revision (add more dates/times and
  // re-send to the group) per proposal, made known to them up front.
  revisionUsed Boolean  @default(false)

  options     DateOption[]
  submissions ProposalSubmission[]
}

// 5.4 - once a member submits their availability for a proposal it's locked
// (no more endless editing); presence of a row here is the lock.
model ProposalSubmission {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    AvailabilityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt DateTime @default(now())

  @@unique([proposalId, userId])
}

model DateOption {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    AvailabilityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  date        DateTime
  allDay      Boolean  @default(true)
  startTime   String?
  endTime     String?

  responses   AvailabilityResponse[]
}

model AvailabilityResponse {
  id           String   @id @default(cuid())
  dateOptionId String
  dateOption   DateOption @relation(fields: [dateOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  available    Boolean

  @@unique([dateOptionId, userId])
}

model WorkDay {
  id              String   @id @default(cuid())
  taskId          String   @unique
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  confirmedDate   DateTime
  allDay          Boolean  @default(true)
  startTime       String?
  endTime         String?
  foodProvided    Boolean  @default(false)
  addressRevealed Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// ---------- Social Tribes Scheduling & Attendance (11.x) ----------
// A parallel, group-id-keyed mirror of the Work Tribe scheduling models
// above (AvailabilityProposal -> WorkDay), used only for "Schedule
// Together" Social Tribes, where there's one shared activity for the whole
// group rather than a per-member task. Kept separate from the Work models
// rather than adding a nullable groupId to them, since Work's scheduling
// tables assume a single task owner/host and an active-task queue that a
// Social Tribe doesn't have.

model SocialEventProposal {
  id           String   @id @default(cuid())
  groupId      String   @unique
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  revisionUsed Boolean  @default(false)

  options     SocialDateOption[]
  submissions SocialProposalSubmission[]
}

model SocialProposalSubmission {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    SocialEventProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt DateTime @default(now())

  @@unique([proposalId, userId])
}

model SocialDateOption {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    SocialEventProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  date        DateTime
  allDay      Boolean  @default(true)
  startTime   String?
  endTime     String?

  responses   SocialAvailabilityResponse[]
}

model SocialAvailabilityResponse {
  id           String   @id @default(cuid())
  dateOptionId String
  dateOption   SocialDateOption @relation(fields: [dateOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  available    Boolean

  @@unique([dateOptionId, userId])
}

// The confirmed date for a Social Tribe's shared activity - the Social
// equivalent of WorkDay, but 1:1 with the Group instead of a Task. Created
// immediately (no scheduling round) for a Fixed Date Tribe, or via
// SocialEventProposal confirmation for a Schedule Together Tribe.
model SocialEvent {
  id            String   @id @default(cuid())
  groupId       String   @unique
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  confirmedDate DateTime
  allDay        Boolean  @default(true)
  startTime     String?
  endTime       String?
  createdAt     DateTime @default(now())
}

// Recorded once per committed member after a Social Tribe's event date has
// passed. Deliberately not RatingEvent - Social attendance has no star
// score (never blended with the Work star rating), just a plain outcome
// feeding Social Reliability.
model SocialAttendance {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome    String   // ATTENDED | NO_SHOW | VALID_REASON
  recordedAt DateTime @default(now())

  @@unique([groupId, userId])
}

// ---------- Group Chat ----------

model GroupChatMessage {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id])
  isSystem  Boolean  @default(false)
  text      String?
  photoUrl  String?
  createdAt DateTime @default(now())

  @@index([groupId])
}

model GroupChatRead {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([groupId, userId])
}

// ---------- Dissolution (4.14) ----------

model DissolutionVote {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requestedBy String
  startedAt   DateTime @default(now())
  endsAt      DateTime
  outcome     String?  // PASSED | FAILED
  resolvedAt  DateTime?

  ballots     DissolutionBallot[]

  @@index([groupId])
}

model DissolutionBallot {
  id      String   @id @default(cuid())
  voteId  String
  vote    DissolutionVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  choice  String   // YES | NO

  @@unique([voteId, userId])
}

// ---------- Ratings & Reputation (Chapter 6) ----------

model RatingEvent {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  raterId     String
  rater       User     @relation("Rater", fields: [raterId], references: [id])
  rateeId     String
  ratee       User     @relation("Ratee", fields: [rateeId], references: [id])

  type        String   // WORKER | HOST
  scoreA      Int      // Worker: Performance   | Host: Hosting
  scoreB      Int      // Worker: Attitude      | Host: Accuracy of Task
  scoreC      Int      // Worker: Reliability   | Host: Attitude
  isNoShow    Boolean  @default(false)   // 6.6 hidden 1/5
  isValidAbsence Boolean @default(false) // 6.6 hidden neutral 3/5

  visible     Boolean  @default(false)  // becomes true when group ends/dissolves (6.7)
  createdAt   DateTime @default(now())

  @@index([rateeId])
  @@index([taskId])
}

// ---------- Notifications (Chapter 8) ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   String?  // JSON blob
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Blocking, Reporting, Favourites ----------

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id               String   @id @default(cuid())
  reporterId       String
  reporter         User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId   String?
  reportedUser     User?    @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reportedGroupId  String?
  reason           String
  details          String?
  status           String   @default("OPEN") // OPEN | REVIEWING | RESOLVED | DISMISSED
  createdAt        DateTime @default(now())
}

model Favourite {
  id               String @id @default(cuid())
  ownerId          String
  owner            User   @relation("FavouriteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  favouriteUserId  String
  favouriteUser    User   @relation("FavouriteTarget", fields: [favouriteUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([ownerId, favouriteUserId])
}

// ---------- Subscriptions (8.5-8.7) ----------

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String   @default("INACTIVE") // ACTIVE | INACTIVE | CANCELED | PAST_DUE
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ---------- Admin (8.9) ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | SUPPORT
  createdAt    DateTime @default(now())

  auditLogs    AdminAuditLog[]
}

// 8.11 - administrative actions are logged with timestamps for an audit trail.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([adminId])
}
